PARSER_PROVIDER=keyword
# Set to 'ollama' in production and add OLLAMA_URL, OLLAMA_MODEL

# ─── AI / LLM Provider Keys (PLACEHOLDERS ONLY — never commit real keys) ──────
GEMINI_API_KEY=your-gemini-key
GEMINI_API_KEYS=key1,key2,key3

GROQ_API_KEY=your-groq-key
GROQ_API_KEYS=key1,key2,key3

OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_API_KEYS=key1,key2,key3

CEREBRAS_API_KEY=your-cerebras-key
CEREBRAS_API_KEYS=key1,key2,key3

MISTRAL_API_KEY=your-mistral-key
MISTRAL_API_KEYS=key1,key2,key3

SAMBANOVA_API_KEY=your-sambanova-key
SAMBANOVA_API_KEYS=key1,key2,key3

# ─── AI Gateway Policy ────────────────────────────────────────────────────────
# Master kill switch — set to false to stop ALL cloud AI immediately
CLOUD_AI_ENABLED=true

# Per-role daily cloud AI call limits
STUDENT_CLOUD_CALLS_PER_DAY=0
FACULTY_CLOUD_CALLS_PER_DAY=1
HOD_CLOUD_CALLS_PER_DAY=5
COS_CLOUD_CALLS_PER_DAY=3
HOS_CLOUD_CALLS_PER_DAY=3
HIGHER_AUTHORITY_CLOUD_CALLS_PER_DAY=3
SUPER_ADMIN_CLOUD_CALLS_PER_DAY=50

# Global budget safety rails
CLOUD_AI_GLOBAL_DAILY_LIMIT=25
CLOUD_AI_GLOBAL_MONTHLY_LIMIT=100

# Per-request token cap
CLOUD_AI_MAX_TOKENS_PER_REQUEST=1500

# Circuit breaker: max provider fallback retries per request
CLOUD_AI_MAX_PROVIDER_RETRIES=2

# Preferred provider order (comma-separated)
CLOUD_AI_PROVIDER_ORDER=groq,cerebras,gemini,openrouter,mistral,sambanova
