# ─────────────────────────────────────────────────────────────────────────
# Lyrahub — Root .env.example
# Copy this file to .env and fill in ALL values marked with <REPLACE_ME>
# NEVER commit the real .env to git.
# ─────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production

# ── Database ──────────────────────────────────────────────────────────────
# Neon (production) — get from https://console.neon.tech
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<db>?ssl=require

# Local Postgres (docker-compose dev)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lyrahub

# ── Redis ─────────────────────────────────────────────────────────────────
# Upstash or Redis Cloud (production) — get from provider dashboard
REDIS_URL=redis://default:<password>@<host>:<port>

# Local Redis (docker-compose dev)
# REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<REPLACE_ME_with_64_char_random_string>
JWT_ACCESS_EXPIRY=900       # 15 minutes
JWT_REFRESH_EXPIRY=604800   # 7 days

# ── Super Admin ───────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@aiml.hub
SUPERADMIN_PASSWORD=<REPLACE_ME_strong_password>

# ── Storage ───────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local   # local | r2
# For Cloudflare R2:
# R2_ACCOUNT_ID=<REPLACE_ME>
# R2_ACCESS_KEY_ID=<REPLACE_ME>
# R2_SECRET_ACCESS_KEY=<REPLACE_ME>
# R2_BUCKET_NAME=lyrahub-uploads

# ── AI / LLM Provider Keys ────────────────────────────────────────────────
# COMMA-SEPARATED lists enable round-robin key rotation
PARSER_PROVIDER=keyword   # keyword | ollama

GEMINI_API_KEY=<REPLACE_ME>
GEMINI_API_KEYS=key1,key2,key3

GROQ_API_KEY=<REPLACE_ME>
GROQ_API_KEYS=key1,key2,key3

OPENROUTER_API_KEY=<REPLACE_ME>
OPENROUTER_API_KEYS=key1,key2,key3

CEREBRAS_API_KEY=<REPLACE_ME>
CEREBRAS_API_KEYS=key1,key2,key3

MISTRAL_API_KEY=<REPLACE_ME>
MISTRAL_API_KEYS=key1,key2,key3

SAMBANOVA_API_KEY=<REPLACE_ME>
SAMBANOVA_API_KEYS=key1,key2,key3

# ── AI Gateway Policy ─────────────────────────────────────────────────────
CLOUD_AI_ENABLED=true

# Per-role daily cloud AI call limits (0 = no access)
STUDENT_CLOUD_CALLS_PER_DAY=0
FACULTY_CLOUD_CALLS_PER_DAY=1
HOD_CLOUD_CALLS_PER_DAY=5
COS_CLOUD_CALLS_PER_DAY=3
HOS_CLOUD_CALLS_PER_DAY=3
HIGHER_AUTHORITY_CLOUD_CALLS_PER_DAY=3
SUPER_ADMIN_CLOUD_CALLS_PER_DAY=50

# Global budget rails
CLOUD_AI_GLOBAL_DAILY_LIMIT=25
CLOUD_AI_GLOBAL_MONTHLY_LIMIT=100

# Per-request token cap
CLOUD_AI_MAX_TOKENS_PER_REQUEST=1500

# Provider fallback retries per request
CLOUD_AI_MAX_PROVIDER_RETRIES=2

# Provider order (comma-separated)
CLOUD_AI_PROVIDER_ORDER=groq,cerebras,gemini,openrouter,mistral,sambanova

# ── Local AI (optional) ───────────────────────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
